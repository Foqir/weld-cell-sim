<?xml version="1.0" encoding="UTF-8"?>
<!-- Official SRDF of the robot model (group hdr_manipulator: base_link -> tool0)
     + group "welder" whose tip is the torch TCP (wire tip) + torch collision exceptions. -->
<robot name="$(arg name)" xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:arg name="name" default="hdr_robot"/>
  <xacro:arg name="model_srdf" default=""/>

  <xacro:include filename="$(arg model_srdf)"/>

  <group name="welder">
    <chain base_link="base_link" tip_link="torch_tcp"/>
  </group>

  <disable_collisions link1="welding_torch" link2="flange_link" reason="Adjacent"/>
  <disable_collisions link1="welding_torch" link2="wrist_holder_link" reason="Never"/>
  <disable_collisions link1="welding_torch" link2="wrist_body_link" reason="Never"/>
</robot>
